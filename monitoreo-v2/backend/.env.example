# Copy to .env for local development (see monitoreo-v2/docs/deploy.md)

# Database — defaults match `docker compose up -d timescaledb`
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=monitoreo_v2
DB_USERNAME=postgres
DB_PASSWORD=monitoreo2026

# Legacy standalone container (docker run --name pg-arauco …):
# DB_NAME=arauco
# DB_PASSWORD=arauco

# OAuth (see monitoreo-v2/frontend/.env.example for VITE_*)
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=

# Required for local API bootstrap (min 32 chars in production)
JWT_SECRET=dev-jwt-secret-change-me-min-32-chars
COOKIE_SECRET=dev-cookie-secret-change-me

# Optional: Amazon SES (alertas + invitaciones de usuario)
# SES_FROM_EMAIL=noreply@verified-domain.example.com
# SES_REGION=us-east-1
# ALERT_EMAIL_RECIPIENTS=ops@example.com,oncall@example.com
