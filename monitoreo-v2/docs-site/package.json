{
  "name": "docs-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && aws s3 sync dist/ s3://power-monitor-dev-docs/ --region us-east-1 --cache-control 'public,max-age=3600' --delete && aws cloudfront create-invalidation --distribution-id EE8564N72RUL8 --paths '/*' --region us-east-1"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
